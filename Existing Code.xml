        _write_ws_preset(paths, _COMBO)
        res = save_preset(
            {"preset_id": "existing_preset",
             "agency_ids": [], "build_types": ["Patrol"], "vehicle_types": ["PIU"],
             "tag": "", "parts": []},
            paths,
        )
