    const n    = (p.build_units || []).reduce((s, u) => s + (u.quantity || 1), 0);
    const pid  = esc(p.project_id);
    return `<div class="proj-row proj-row-clickable" onclick="PT_open('${pid}')">
      <div class="proj-row-main">
        <div class="proj-row-agency">${name}</div>
