    </div>

    <label style="display:flex;align-items:center;gap:8px;margin-bottom:6px;cursor:pointer;font-size:13px;font-weight:600">
      <input type="checkbox" id="me-include" checked>
      Include in Build Drawing
    </label>

    <div class="modal-actions">
      <button class="btn btn-secondary" onclick="meCancelModal()">Cancel</button>
      <button class="btn btn-primary" id="me-btn-save" onclick="savePartEdit()">Save Part</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="preset-edit-modal" role="dialog" aria-modal="true">
  <div class="modal" style="max-width:560px">
    <div class="modal-title">
      Preset Settings
      <button class="modal-close" id="pem-close" title="Close">✕</button>
    </div>

    <!-- Auto-generated name preview -->
    <div style="background:var(--active-bg,#f0f4ff);border:1px solid var(--border);border-radius:6px;padding:10px 14px;margin-bottom:14px">
      <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:4px">Auto-generated Name</div>
      <div id="pem-name-preview" style="font-size:14px;font-weight:600">—</div>
    </div>

    <!-- Description -->
    <div class="form-group" style="margin-bottom:12px">
      <label>Description</label>
      <input id="pem-description" type="text" placeholder="Optional description shown in preset picker">
    </div>

    <!-- Agency assignment -->
    <div class="form-group" style="margin-bottom:12px">
      <label>Agency Assignment <span style="font-weight:400;color:var(--muted)">(leave blank for universal)</span></label>
      <div id="pem-agency-checks" style="max-height:120px;overflow-y:auto;border:1px solid var(--border);border-radius:5px;padding:8px">
        <p style="font-size:12px;color:var(--muted);margin:0">Loading agencies…</p>
      </div>
    </div>

    <!-- Build types -->
    <div class="form-group" style="margin-bottom:12px">
      <label>Compatible Build Types <span style="font-weight:400;color:var(--muted)">(leave blank for any)</span></label>
      <div id="pem-bt-checks" style="display:flex;flex-wrap:wrap;gap:6px 16px;padding:4px 0"></div>
    </div>

    <!-- Vehicle types -->
    <div class="form-group" style="margin-bottom:12px">
      <label>Compatible Vehicles <span style="font-weight:400;color:var(--muted)">(leave blank for any)</span></label>
      <div id="pem-vehicle-checks" style="max-height:120px;overflow-y:auto;border:1px solid var(--border);border-radius:5px;padding:8px"></div>
    </div>

    <!-- Tag (General presets only) -->
    <div class="form-group" id="pem-tag-row" style="margin-bottom:12px">
      <label>Tag <span style="font-weight:400;color:var(--muted)">(optional — disambiguates General presets with the same vehicles)</span></label>
      <input id="pem-tag" type="text" placeholder="e.g. Special Ops, Canine">
    </div>

    <!-- Parts count + export -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;font-size:13px">
      <span style="color:var(--muted)">Parts:</span>
      <span id="pem-part-count" style="font-weight:600">—</span>
      <button class="btn btn-secondary btn-sm" id="pem-export-btn" style="margin-left:auto">Export to Workbook ↓</button>
    </div>

    <div class="modal-actions">
      <button class="btn btn-secondary" id="pem-cancel">Cancel</button>
      <button class="btn btn-primary" id="pem-save">Save Preset</button>
    </div>
  </div>
</div>

