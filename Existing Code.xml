  $("tpl-label").textContent="🔄 Regenerate Workbook Template";
  $("btn-regen-template").disabled=false;
});

$("btn-open").addEventListener("click", ()=>api("/open",{path:window._outputPath}));

$("btn-export-pdf").addEventListener("click", async ()=>{
