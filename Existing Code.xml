        rest = path[len("/api/draft/"):-len("/delete")]
        if "/part/" in rest:
            draft_id, line_id = rest.split("/part/", 1)
            if draft_id and line_id and "/" not in draft_id and "/" not in line_id:
                _json(handler, handle_remove_part_from_draft(draft_id, line_id, paths))
