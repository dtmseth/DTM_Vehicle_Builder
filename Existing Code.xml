function _ptRenderList() {
  if (!_PT.projects.length) {
    show("proj-list-empty");
    hide("proj-list-rows");
    return;
  }
  hide("proj-list-empty");
  show("proj-list-rows");
  $("proj-list-rows").innerHTML = _PT.projects.map(p => {
