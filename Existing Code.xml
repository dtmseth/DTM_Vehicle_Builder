<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DTM Vehicle Builder</title>
  <link rel="stylesheet" href="/ui/styles.css">
</head>
<body>

<div class="app-header">
  <div class="header-brand">
    <div class="logo-badge">DTM</div>
    <div><h1>Build Sheet Generator</h1><p>v7 · DTM Technologies</p></div>
  </div>
  <div class="header-tabs">
    <button class="htab" data-tab="projects">📋 Projects</button>
    <button class="htab" data-tab="settings">⚙️ Settings</button>
  </div>
</div>



<!-- ═══════════ SETTINGS TAB ═══════════ -->
<div id="tab-settings" class="main-content" hidden>
  <div class="stab-bar">
    <button class="stab active" data-stab="placements">📍 Placements</button>
    <button class="stab" data-stab="fixtures">🏗 Fixtures</button>
    <button class="stab" data-stab="sizes">📐 Size Rules</button>
    <button class="stab" data-stab="catalog">📋 Part Types</button>
    <button class="stab" data-stab="parts">🔩 Parts Library</button>
    <button class="stab" data-stab="vehicles">🚗 Vehicles</button>
    <button class="stab" data-stab="agencies">🏛 Agencies</button>
    <button class="stab" data-stab="sales-reps">👤 Sales Reps</button>
    <button class="stab" data-stab="presets">📂 Presets</button>
    <button class="stab" data-stab="tools">🔧 Tools</button>
  </div>

  <!-- ── PLACEMENTS ── -->
  <div id="stab-placements">
    <div class="card">
      <div class="card-title">
        Vehicle Layout — Placements
        <div style="display:flex;align-items:center;gap:8px">
          <span class="unsaved-dot" id="placements-dirty-dot"></span>
          <button class="btn btn-primary btn-sm" id="btn-save-layouts">Save Changes</button>
        </div>
      </div>

      <!-- vehicle + view selectors -->
      <div class="placements-header">
        <div class="vehicle-select-wrap">
          <label>Vehicle</label>
          <select id="vehicle-selector"></select>
        </div>
        <div class="view-pill-bar" id="view-pills">
          <button class="view-pill active" data-view="front">Front</button>
          <button class="view-pill" data-view="side">Side</button>
          <button class="view-pill" data-view="top">Top</button>
          <button class="view-pill" data-view="rear">Rear</button>
        </div>
      </div>

      <!-- LARGE CANVAS – full width above the list -->
      <div class="canvas-wrap">
        <canvas id="vehicle-canvas" width="700" height="460"></canvas>
      </div>
      <div class="canvas-hint">Click on the diagram to move the selected location (gold dot) · All other locations shown in navy</div>

      <!-- Two-column layout below canvas -->
      <div class="placement-cols" style="margin-top:14px">
        <!-- Left: location list -->
        <div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:8px">Locations</div>
          <div class="location-list" id="location-list"></div>
          <div class="loc-list-actions">
            <button class="btn btn-secondary btn-sm" style="flex:1" id="btn-add-location">+ Add Location</button>
          </div>
        </div>
        <!-- Right: edit panel -->
        <div>
          <div id="loc-edit-panel" hidden>
            <div class="location-edit-panel">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <div style="font-size:13px;font-weight:700;color:var(--navy)" id="loc-edit-title"></div>
                <button class="btn btn-danger btn-sm" id="btn-delete-location">🗑 Delete</button>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Location Name</label>
                  <input id="loc-name-input" type="text" />
                </div>
              </div>
              <div class="coord-row">
                <label>X</label>
                <input type="range" id="loc-x-range" min="0" max="1" step="0.005" />
                <input type="number" id="loc-x-num" min="0" max="1" step="0.005" />
              </div>
              <div class="coord-row">
                <label>Y</label>
                <input type="range" id="loc-y-range" min="0" max="1" step="0.005" />
                <input type="number" id="loc-y-num" min="0" max="1" step="0.005" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Orientation</label>
                  <select id="loc-orient">
                    <option value="h">Horizontal (h)</option>
                    <option value="v">Vertical (v)</option>
                    <option value="bar">Bar</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>Pattern</label>
                  <select id="loc-pattern">
                    <option value="single">Single</option>
                    <option value="mirror">Mirror</option>
                  </select>
                </div>
                <div class="form-group" style="max-width:80px">
                  <label>Slots</label>
                  <input type="number" id="loc-slots" min="1" max="8" />
                </div>
              </div>
              <!-- H-Spacing row — only relevant for horizontal / mirror multi-slot -->
              <div id="loc-spacing-row" hidden>
                <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px">
                  H Spacing
                  <span style="font-weight:400;text-transform:none;font-size:10px">(relative to image width — 0 = auto)</span>
                </div>
