        return;
      }
      await _ptLoadAll();
      const updated = _PT.projects.find(p => p.project_id === projectId) || project;
      _PT.viewProject = updated;
      await _ptShowBuildEditor(res.draft_id, unit, updated, "builds");
    } catch (e) {
      if (statusEl) _ptSetStatus(statusEl, "❌ " + (e.message || "Error"), "err");
    }
  }
};

