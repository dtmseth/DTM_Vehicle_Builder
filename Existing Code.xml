dtm-buildsheet-generate = "dtm_buildsheet.generator_cli:main"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v"

[tool.setuptools]
package-dir = {"" = "src"}
include-package-data = true

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
dtm_buildsheet = [
  "ui/index.html",
  "ui/styles.css",
