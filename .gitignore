.claude/
__pycache__/
*.py[cod]
.DS_Store

workspace/

# Config file backups written at runtime
src/dtm_buildsheet/resources/config/history/

# Cloud sync eTag cache (workspace state — happens to live in resources/ in dev mode)
src/dtm_buildsheet/resources/config/.settings_etags.json
src/dtm_buildsheet/resources/default_data/agencies/.settings_etags.json
src/dtm_buildsheet/resources/default_data/sales_reps/.settings_etags.json

# Bundled presets were removed in v2.2.10; resources/presets/ is now
# only the dev mode workspace mirror of /Settings/presets/ on SharePoint.
# Anything that lands there is cloud-synced user data, not source.
src/dtm_buildsheet/resources/presets/*.json

dist/
build/
*.egg-info/
.coverage
htmlcov/
relay/node_modules/

existing_code.xml

# Throwaway connection test — contains secrets in plaintext
test_graph_connection.py

# QuickBooks integration local connection metadata. Non-secret (client_id,
# environment, expiry timestamps), but per-machine and never cloud-synced.
# Secrets (client_secret, tokens, realm_id) live in the OS keychain, never
# on disk. Defensive entries — in dev these already fall under workspace/.
quickbooks_config.json
src/dtm_buildsheet/resources/config/quickbooks_config.json
quickbooks_items_cache.json
src/dtm_buildsheet/resources/config/quickbooks_items_cache.json
